{
    "name": "fof/github-sponsors",
    "description": "GitHub Sponsors integration for your Flarum forum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/github-sponsors/issues",
        "source": "https://github.com/FriendsOfFlarum/github-sponsors",
        "forum": "https://discuss.flarum.org/d/22260"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^1.2.0",
        "guzzlehttp/guzzle": "^7.1"
    },
    "authors": [
        {
            "name": "David Sevilla Martin",
            "email": "me+fof@datitisev.me",
            "homepage": "https://datitisev.me",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\GitHubSponsors\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF GitHub Sponsors",
            "category": "feature",
            "icon": {
                "name": "fab fa-github",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flagrow": {
            "discuss": "https://discuss.flarum.org/d/22260"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "flarum/phpstan": "*",
        "flarum/testing": "^1.0.0"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\GitHubSponsors\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
